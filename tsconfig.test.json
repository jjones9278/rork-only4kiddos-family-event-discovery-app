{
  // Compiles the plain-TS unit tests in __tests__/ for Node's built-in test
  // runner (`npm test`) — no Jest/Expo transform needed for pure modules.
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": ".",
    "outDir": ".test-build"
  },
  "include": ["__tests__/**/*.ts"]
}
